{
  "name": "@xberg-io/sdk",
  "version": "0.9.0",
  "description": "Official TypeScript client for the Xberg Enterprise and Xberg Pro document-processing APIs.",
  "license": "MIT",
  "author": "Na'aman Hirschfeld <naaman@xberg.io>",
  "contributors": ["Tobias Perlstein <tobias@xberg.io>"],
  "homepage": "https://xberg.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xberg-io/sdks.git",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/xberg-io/sdks/issues"
  },
  "keywords": ["xberg", "enterprise", "pro", "openapi", "client", "sdk", "document-extraction"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run generate && tsdown",
    "generate": "bash scripts/generate.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests && tsc --noEmit",
    "format": "oxfmt --write src tests",
    "format:check": "oxfmt --check src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2"
}
